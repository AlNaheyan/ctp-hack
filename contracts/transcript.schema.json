{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discussion-analyzer.local/contracts/v1/transcript.schema.json",
  "title": "Normalized Transcript v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "videoId", "language", "captionSource", "fetchedAt", "segments"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "videoId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$",
      "maxLength": 35
    },
    "captionSource": { "enum": ["manual", "automatic"] },
    "fetchedAt": { "$ref": "#/$defs/utcTimestamp" },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/segment" }
    }
  },
  "$defs": {
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "seconds": { "type": "number", "minimum": 0 },
    "stableId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$" },
    "segment": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "startTime", "endTime", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "startTime": { "$ref": "#/$defs/seconds" },
        "endTime": { "$ref": "#/$defs/seconds" },
        "speaker": { "type": "string", "minLength": 1, "maxLength": 200 },
        "text": { "type": "string", "minLength": 1, "maxLength": 10000 }
      }
    }
  },
  "x-contractChecks": [
    "segment IDs are unique",
    "startTime <= endTime",
    "segments sorted by startTime then id",
    "text is not whitespace-only",
    "UTF-8 payload is at most 5242880 bytes"
  ]
}
