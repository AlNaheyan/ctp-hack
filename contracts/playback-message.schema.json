{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discussion-analyzer.local/contracts/v1/playback-message.schema.json",
  "title": "Playback State Message v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "type", "payload"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "type": { "const": "PLAYBACK_STATE" },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "required": ["videoId", "currentTime", "duration", "paused", "playbackRate", "observedAt"],
      "properties": {
        "videoId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" },
        "currentTime": { "type": "number", "minimum": 0 },
        "duration": { "type": "number", "minimum": 0 },
        "paused": { "type": "boolean" },
        "playbackRate": { "type": "number", "exclusiveMinimum": 0 },
        "observedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
        }
      }
    }
  },
  "x-contractChecks": [
    "currentTime <= duration when duration is nonzero",
    "UTF-8 payload is at most 8192 bytes"
  ]
}
