# Boring Notch discussion analyzer - local environment template (W1-T4).
#
# Usage:
#   cp .env.example .env
#
# Rules:
#   - .env is git-ignored. Never commit it, never paste real keys into docs,
#     issues, screenshots, or fixtures.
#   - Secrets belong to the backend process only. No key may be added to the
#     Chrome extension, the macOS app bundle, or any tracked file.
#   - Mock mode requires no secrets at all. You only need a key once the live
#     analysis pipeline (W2-T2 / W3-T1) is wired up.
#   - Rotate any key that has ever been committed or shared in chat.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# mock = serve golden fixtures, no network, no secrets (Wave 1 default).
# live = call the real transcript + analysis pipeline (Wave 2/3).
ANALYSIS_MODE=mock

# Port for the local backend (mock API today, real API from W3-T1).
PORT=8787

# Interface to bind. Keep it loopback-only on shared networks.
HOST=127.0.0.1

# error | warn | info | debug
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Fixtures (canonical location is owned by W1-T2)
# ---------------------------------------------------------------------------

# Absolute or repo-relative path to the canonical fixtures directory.
# Leave unset to use <repo>/fixtures. Do not copy fixtures elsewhere.
# FIXTURES_DIR=

# ---------------------------------------------------------------------------
# Mock behaviour (ignored when ANALYSIS_MODE=live)
# ---------------------------------------------------------------------------

# Artificial delay on analyze responses, for exercising processing/loading UI.
MOCK_LATENCY_MS=0

# Default scenario for every analyze request: ok | processing | no_transcript |
# rate_limited | backend_error | upstream_timeout
# Per-request override: ?scenario=... or the x-mock-scenario header.
MOCK_SCENARIO=ok

# ---------------------------------------------------------------------------
# Analysis pipeline (W2-T2)
# ---------------------------------------------------------------------------

# Per-request model timeout in milliseconds (1000-300000). A slower request
# fails with UPSTREAM_TIMEOUT rather than hanging the caller.
ANALYSIS_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Secrets (live mode only - leave blank in mock mode)
# ---------------------------------------------------------------------------

# Google Gemini API key used by the analysis pipeline (W2-T2).
# Mock mode uses the offline stub analyzer and needs no key.
GEMINI_API_KEY=

# Optional override for the analysis model id. Empty uses the adapter default
# (gemini-2.5-flash). Changing it changes the analysis cache key.
# GEMINI_MODEL=
